name: Build and Push Docker Image
run-name: {% raw %}${{ github.actor }}{% endraw %} ran Build and Push

on:
  push:
    branches:
      - main

jobs:
  build_push:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write
      actions: write
    env:
      AWS_REGION: {% raw %}${{ vars.AWS_REGION || 'us-east-1' }}{% endraw %}
      AWS_SHARED_SERVICES_ACCOUNT_ID: {% raw %}${{ vars.AWS_SHARED_SERVICES_ACCOUNT_ID || '560167829275' }}{% endraw %}
      CODEARTIFACT_DOMAIN: {% raw %}${{ vars.CODEARTIFACT_DOMAIN || 'mentor-forge' }}{% endraw %}
      CODEARTIFACT_NPM_REPO: {% raw %}${{ vars.CODEARTIFACT_NPM_REPO || 'mentorhub-npm' }}{% endraw %}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: {% raw %}${{ secrets.AWS_ROLE_ARN_READ }}{% endraw %}
          aws-region: {% raw %}${{ env.AWS_REGION }}{% endraw %}

      - name: Get CodeArtifact npm token
        id: ca_npm
        run: |
          TOKEN=$(aws codeartifact get-authorization-token \
            --domain "${CODEARTIFACT_DOMAIN}" \
            --domain-owner "${AWS_SHARED_SERVICES_ACCOUNT_ID}" \
            --query authorizationToken --output text)
          echo "token=$TOKEN" >> "$GITHUB_OUTPUT"

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.repository_owner }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          tags: {{org.docker_host}}/{{org.docker_org}}/{{info.slug}}_{{service.name}}_spa:latest
          secrets: |
            codeartifact_token={% raw %}${{ steps.ca_npm.outputs.token }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
